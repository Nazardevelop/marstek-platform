# Copy to .env (git-ignored) and fill in.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL=sqlite:////app/data/db.sqlite3

# Marstek device (Local API must be enabled in the Marstek app)
MARSTEK_HOST=192.168.1.50
MARSTEK_PORT=30000
MARSTEK_TIMEOUT=2.0

# AI assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LOG_LEVEL=INFO
# Local time zone for daily energy totals, e.g. Europe/Kyiv
TIME_ZONE=UTC
